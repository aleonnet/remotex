<?xml version="1.0" encoding="UTF-8"?>
<!--
  remotex-agent's Windows package, for the machine a gateway's RDP target is: the agent under
  %ProgramFiles%\remotex-agent and the RemotexAgent service that runs it, started at install and
  at every boot. The service runs `remotex-agent service` as LocalSystem, which captures nothing
  itself: it starts `remotex-agent session` as the user of each session attached over RDP, which
  sends that session's desktop to the gateway on the connection's own `remotex.video` channel
  (docs/agent.md). There is no configuration: the gateway's target says whether it takes the
  stream (`agent_passthrough`), and the plan comes from the gateway on the channel.

  The logs are the service's in %SystemRoot%\System32\LogFiles\remotex-agent and each user's in
  %LOCALAPPDATA%\remotex-agent. They are the program's, not the package's, and neither an upgrade
  nor a removal touches them.

  The Visual C++ runtime goes beside the executable: libvpx's
  prebuilt archive is built against the DLL C runtime, and the package must not depend on a
  machine having the redistributable installed. It is the toolset's own copy from VC\Redist,
  which Microsoft permits applications to deploy locally.

  Built by packaging/build-windows-agent.ps1 with WiX 5 (`wix build`) and its UI and Util
  extensions, which defines
    Version: Cargo's version with any pre-release suffix removed (an MSI version is x.y.z)
    Stage:   remotex-agent.exe with vcruntime140.dll and vcruntime140_1.dll
  The UpgradeCode is what makes a newer MSI replace an installed older one instead of sitting
  beside it; it must never change, and it is neither the gateway's nor the viewer's: the three
  are separate products. An upgrade stops the service, replaces the files and starts it again.

  The UI is WiX's stock InstallDir wizard with its licence page skipped, as the gateway's
  package does (remotex.wxs).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="remotex agent" Manufacturer="andrewtheguy" Version="$(var.Version)"
           UpgradeCode="b4bfb592-c0fd-4d1c-b886-f5a05f812dcc" Scope="perMachine">
    <SummaryInformation Description="Sends a Windows session's desktop to remotex over the session's own RDP connection" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of remotex agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrewtheguy/remotex" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="The remotex agent service is running, and sends the desktop of each session attached over RDP to a gateway whose target sets agent_passthrough = true." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="remotex-agent" />
    </StandardDirectory>

    <ComponentGroup Id="Agent" Directory="INSTALLFOLDER">
      <Component>
        <File Id="RemotexAgentExe" Source="$(var.Stage)\remotex-agent.exe" KeyPath="yes" />
        <!-- The name is the one the program registers its control handler under
             (src/service.rs), and the one every script and document names. -->
        <ServiceInstall Id="RemotexAgentService" Name="RemotexAgent" DisplayName="remotex agent"
                        Description="Sends the desktop of each session attached over RDP to remotex, as VP9 on the session's own connection."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                        Arguments="service" Vital="yes">
          <!-- A service that ended without being asked to is started again, 10 seconds later,
               however often it happens: the sessions' agents are its to keep. The Util
               extension's, because Windows Installer's own MsiServiceConfigFailureActions
               fails the install with error 1939. -->
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="RemotexAgentControl" Name="RemotexAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component>
        <File Source="$(var.Stage)\vcruntime140.dll" />
      </Component>
      <Component>
        <File Source="$(var.Stage)\vcruntime140_1.dll" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="Agent" />
    </Feature>
  </Package>
</Wix>
